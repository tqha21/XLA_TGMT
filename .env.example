FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=production-super-secret-key-change-me-2026

# Limits
MAX_CONTENT_LENGTH=20971520
MAX_IMAGE_PIXELS=100000000

# Redis & Celery broker config
# Local (without Docker): redis://localhost:6379/0
# Inside Docker Compose: redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage folders
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
